# .env.example — copy to .env (gitignored). Every value is optional for the
# local demo; the cloud deployment (docker-compose.gcp.yml) needs them all.

# Shared secret for the API. The device (device/config.py → API_KEY) and the
# dashboard send the same value. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AURASENSE_API_KEY=

# ── Cloud deployment only ─────────────────────────────────────────────────────
GCP_PROJECT=
GCP_CREDENTIALS_PATH=./secrets/gcp-service-account.json
BQ_DATASET=iot_data
BQ_TABLE=sensor_logs
GEMINI_API_KEY=
OPENWEATHER_API_KEY=

# ── Local demo options ────────────────────────────────────────────────────────
# Simulator scenario: mixed | normal | stuffy | dry
SIM_SCENARIO=mixed
LOG_LEVEL=INFO
