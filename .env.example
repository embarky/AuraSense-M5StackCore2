# .env.example — copy to .env (gitignored) and fill in.
# Used by docker-compose.yml.

# Shared secret for the API. The device (device/config.py → API_KEY) and the
# dashboard must send the same value. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AURASENSE_API_KEY=

# Google Cloud
GCP_PROJECT=your-gcp-project-id
GCP_CREDENTIALS_PATH=./secrets/gcp-service-account.json
BQ_DATASET=iot_data
BQ_TABLE=sensor_logs

# Backend config file with the Gemini / OpenWeatherMap keys (see backend/config-example.json)
BACKEND_CONFIG_PATH=./backend/config.json

LOG_LEVEL=INFO
